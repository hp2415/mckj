#
# 运营后台 operation_backend
# 复制为 .env 后生效。可与核心 backend 共用同一 DATABASE_URL / SECRET_KEY。
#

DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/ai_assistant_db

# 与核心 backend 相同即可；JWT 靠 aud=operation 隔离
SECRET_KEY=change-me

# 0/false 关闭 /docs
ENABLE_API_DOCS=1

# 开发 Vite 源；生产同域可留空
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 员工自助登录开关
OP_STAFF_LOGIN_ENABLED=0

# JWT 有效期（小时）
OP_JWT_EXPIRE_HOURS=12

# 邀请码默认
OP_INVITE_DEFAULT_DAYS=7
OP_INVITE_DEFAULT_MAX_USES=1

# DB 连接池（运营宜小于核心）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# 活动海报：通过核心 backend 内部 API 上传/删文件；浏览器展示走公开 /media（与桌面一致）
# 生产跨容器必填；INTERNAL_API_KEY 须与 backend/.env 一致
BACKEND_BASE_URL=http://127.0.0.1:8000
# 浏览器访问 backend 的地址（可与上相同；外网部署可写成公网域名）
# BACKEND_PUBLIC_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-internal-key

# 仅当未配置 BACKEND_BASE_URL 时才用本地目录 fallback（默认 ../backend/media）
# MEDIA_DIR=
